{
  "name": "veilroute",
  "version": "0.1.0",
  "description": "Official Node.js and TypeScript SDK for the VeilRoute API.",
  "license": "MIT",
  "author": "VeilRoute <support@veilroute.dev>",
  "homepage": "https://veilroute.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veilroutesdk/veilroute-node.git"
  },
  "bugs": {
    "url": "https://github.com/veilroutesdk/veilroute-node/issues"
  },
  "keywords": [
    "veilroute",
    "sdk",
    "api-client",
    "http-client",
    "telemetry"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
